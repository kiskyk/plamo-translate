+export const createWorker = (
+  workerUrl: string,
+  runOptions: WorkerRunOptions
+): Worker => {
+  const url = new URL(workerUrl);
+  url.searchParams.set('options', JSON.stringify(runOptions));
+  return new Worker(url.href);
 };
 
