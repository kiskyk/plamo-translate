+static void ggml_webgpu_disable_subgroups(webgpu_capabilities & caps) {
+    caps.supports_subgroups       = false;
+    caps.supports_subgroup_matrix = false;
+    caps.min_subgroup_size        = 0;
+    caps.max_subgroup_size        = 0;
+}
