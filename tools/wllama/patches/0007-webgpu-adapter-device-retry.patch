+static void ggml_webgpu_apply_granted_device_caps(ggml_backend_webgpu_reg_context * ctx) {
+    auto & device = ctx->webgpu_global_ctx->device;
+    auto & caps   = ctx->webgpu_global_ctx->capabilities;
+    device.GetLimits(&caps.limits);
+    // Shader selection (enable subgroups) must follow the *device*, not the
+    // adapter. A later retry that only lowers limits still requests Subgroups
+    // when the adapter has it; a last-resort f16-only device must take the
+    // workgroup-reduction shaders (USE_WORKGROUP_REDUCTION).
+    caps.supports_subgroups = device.HasFeature(wgpu::FeatureName::Subgroups);
+    // A granted Subgroups feature is not enough: shaders still need a reported
+    // size. Unknown/zero would otherwise reach specialization constants.
+    if (caps.supports_subgroups &&
+        (caps.min_subgroup_size == 0 || caps.max_subgroup_size == 0 ||
+         caps.max_subgroup_size < caps.min_subgroup_size)) {
+        GGML_LOG_INFO(
+            "ggml_webgpu: device has subgroups but size unknown or invalid (min=%u max=%u); disabling subgroups\n",
+            caps.min_subgroup_size, caps.max_subgroup_size);
+        caps.supports_subgroups       = false;
+        caps.supports_subgroup_matrix = false;
+        caps.min_subgroup_size        = 0;
+        caps.max_subgroup_size        = 0;
+    }
+#if !defined(__EMSCRIPTEN__) && !defined(__wasi__)
+    if (!device.HasFeature(wgpu::FeatureName::ChromiumExperimentalSubgroupMatrix)) {
+        caps.supports_subgroup_matrix = false;
+    }
+#endif
+    GGML_LOG_INFO("ggml_webgpu: device features: shader-f16=%s subgroups=%s\n",
+                  device.HasFeature(wgpu::FeatureName::ShaderF16) ? "true" : "false",
+                  caps.supports_subgroups ? "true" : "false");
+    GGML_LOG_INFO(
+        "ggml_webgpu: device limits: maxBufferSize=%llu maxStorageBufferBindingSize=%llu "
+        "maxComputeWorkgroupStorageSize=%u maxComputeInvocationsPerWorkgroup=%u min_subgroup_size=%u "
+        "max_subgroup_size=%u\n",
+        (unsigned long long) caps.limits.maxBufferSize,
+        (unsigned long long) caps.limits.maxStorageBufferBindingSize, caps.limits.maxComputeWorkgroupStorageSize,
+        caps.limits.maxComputeInvocationsPerWorkgroup, caps.min_subgroup_size, caps.max_subgroup_size);
+}
