+// Known-answer workgroup add plus, when subgroups are enabled, a readback of
+// subgroup_size. A guessed MAX_SUBGROUP_SIZE (e.g. 64 on wave32 hardware) would
+// otherwise silently corrupt reductions. Size mismatch → drop subgroups and use
+// the workgroup-reduction shaders. Add mismatch → drop the device.
+static bool ggml_webgpu_correctness_probe(ggml_backend_webgpu_reg_context * ctx) {
+#ifdef __EMSCRIPTEN__
+    const double t0 = emscripten_get_now();
+#else
+    const double t0 = 0;
+#endif
+    auto & caps = ctx->webgpu_global_ctx->capabilities;
+
+    uint32_t add_sum = 0;
+    if (!ggml_webgpu_run_u32_probe(ctx, ggml_webgpu_probe_add_wgsl(), "correctness_add", &add_sum)) {
+        GGML_LOG_ERROR("ggml_webgpu: correctness probe failed; could not dispatch add kernel\n");
+        return false;
+    }
+    if (add_sum != GGML_WEBGPU_PROBE_ADD_SUM) {
+        GGML_LOG_ERROR("ggml_webgpu: correctness probe failed; add sum %u != %u\n", add_sum, GGML_WEBGPU_PROBE_ADD_SUM);
+        return false;
+    }
+
+    uint32_t subgroup_size = 0;
+    if (caps.supports_subgroups) {
+        if (!ggml_webgpu_run_u32_probe(ctx, ggml_webgpu_probe_subgroup_wgsl(), "correctness_subgroup",
+                                       &subgroup_size)) {
+            GGML_LOG_INFO("ggml_webgpu: correctness probe: disabling subgroups (subgroup shader failed)\n");
+            ggml_webgpu_disable_subgroups(caps);
+            subgroup_size = 0;
+        } else {
+            const uint32_t min_sg = caps.min_subgroup_size;
+            const uint32_t max_sg = caps.max_subgroup_size;
+            if (subgroup_size == 0 || min_sg == 0 || max_sg == 0 || subgroup_size < min_sg ||
+                subgroup_size > max_sg) {
+                GGML_LOG_INFO(
+                    "ggml_webgpu: correctness probe: disabling subgroups (hardware subgroup_size=%u not in [%u,%u])\n",
+                    subgroup_size, min_sg, max_sg);
+                ggml_webgpu_disable_subgroups(caps);
+            }
+        }
+    }
+
+#ifdef __EMSCRIPTEN__
+    const double ms = emscripten_get_now() - t0;
+#else
+    const double ms = 0;
+#endif
+    GGML_LOG_INFO("ggml_webgpu: correctness probe: ok subgroups=%s subgroup_size=%u add=%u ms=%.1f\n",
+                  caps.supports_subgroups ? "true" : "false", subgroup_size, add_sum, ms);
+    return true;
 }
 
