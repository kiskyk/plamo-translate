+static bool ggml_webgpu_run_u32_probe(ggml_backend_webgpu_reg_context * ctx,
+                                      const char *                     wgsl,
+                                      const char *                     label,
+                                      uint32_t *                       out_value) {
+    auto & device = ctx->webgpu_global_ctx->device;
+    auto & queue  = ctx->webgpu_global_ctx->queue;
+    if (device == nullptr || queue == nullptr) {
+        return false;
+    }
+
+    const size_t bytes = GGML_WEBGPU_PROBE_BUF_U32 * sizeof(uint32_t);
+    wgpu::Buffer gpu_buf;
+    wgpu::Buffer host_buf;
+    ggml_webgpu_create_buffer(device, gpu_buf, bytes, wgpu::BufferUsage::Storage | wgpu::BufferUsage::CopySrc, label);
+    ggml_webgpu_create_buffer(device, host_buf, bytes, wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst,
+                              "probe_host");
+    if (gpu_buf == nullptr || host_buf == nullptr) {
+        return false;
+    }
+
+    webgpu_pipeline pipeline = ggml_webgpu_create_pipeline(device, wgsl, label);
+    if (pipeline.pipeline == nullptr) {
+        gpu_buf.Destroy();
+        host_buf.Destroy();
+        return false;
+    }
+
+    wgpu::BindGroupEntry      entry         = ggml_webgpu_make_bind_group_entry(0, gpu_buf, 0, bytes);
+    wgpu::BindGroupDescriptor bind_group_desc;
+    bind_group_desc.layout     = pipeline.pipeline.GetBindGroupLayout(0);
+    bind_group_desc.entryCount = 1;
+    bind_group_desc.entries    = &entry;
+    bind_group_desc.label      = label;
+    wgpu::BindGroup bind_group = device.CreateBindGroup(&bind_group_desc);
+
+    wgpu::CommandEncoder     encoder  = device.CreateCommandEncoder();
+    wgpu::ComputePassEncoder pass     = encoder.BeginComputePass();
+    pass.SetPipeline(pipeline.pipeline);
+    pass.SetBindGroup(0, bind_group);
+    pass.DispatchWorkgroups(1, 1, 1);
+    pass.End();
+    encoder.CopyBufferToBuffer(gpu_buf, 0, host_buf, 0, bytes);
+    wgpu::CommandBuffer commands = encoder.Finish();
+    queue.Submit(1, &commands);
+    ggml_backend_webgpu_wait_queue(ctx->webgpu_global_ctx);
+    ggml_backend_webgpu_map_buffer(ctx->webgpu_global_ctx, host_buf, wgpu::MapMode::Read, 0, bytes);
+    const uint32_t * mapped = static_cast<const uint32_t *>(host_buf.GetConstMappedRange(0, bytes));
+    if (mapped == nullptr) {
+        host_buf.Unmap();
+        gpu_buf.Destroy();
+        host_buf.Destroy();
+        return false;
+    }
+    *out_value = mapped[0];
+    host_buf.Unmap();
+    gpu_buf.Destroy();
+    host_buf.Destroy();
+    return true;
+}
