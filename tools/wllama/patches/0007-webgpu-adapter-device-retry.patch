+static constexpr uint32_t GGML_WEBGPU_PROBE_ADD_WG  = 16;
+static constexpr uint32_t GGML_WEBGPU_PROBE_ADD_SUM = 136;  // 1+...+16
+static constexpr uint32_t GGML_WEBGPU_PROBE_BUF_U32 = 16;
+
+static const char * ggml_webgpu_probe_add_wgsl() {
+    return R"(
+@group(0) @binding(0) var<storage, read_write> out: array<u32>;
+var<workgroup> tmp: array<u32, 16>;
+@compute @workgroup_size(16)
+fn main(@builtin(local_invocation_index) li: u32) {
+    tmp[li] = li + 1u;
+    workgroupBarrier();
+    if (li == 0u) {
+        var s = 0u;
+        for (var i = 0u; i < 16u; i++) {
+            s += tmp[i];
+        }
+        out[0] = s;
+    }
+}
+)";
+}
+
+static const char * ggml_webgpu_probe_subgroup_wgsl() {
+    return R"(
+enable subgroups;
+@group(0) @binding(0) var<storage, read_write> out: array<u32>;
+@compute @workgroup_size(128)
+fn main(@builtin(subgroup_size) sg: u32, @builtin(local_invocation_index) li: u32) {
+    if (li == 0u) {
+        out[0] = sg;
+    }
+}
+)";
+}
