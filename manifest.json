{
  "manifest_version": 3,
  "name": "PLaMo Translate (local)",
  "version": "0.4.0",
  "description": "Unofficial. Translates web pages and PDFs with PLaMo 3 Translate on this PC (in the browser, or llama-server).",
  "key": "",
  "permissions": ["scripting", "activeTab", "contextMenus", "storage", "unlimitedStorage", "tabs", "nativeMessaging", "alarms", "offscreen"],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" },
  "cross_origin_embedder_policy": { "value": "require-corp" },
  "cross_origin_opener_policy": { "value": "same-origin" },
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "このページを翻訳（PDF なら翻訳ビューアで開く）" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+T" } },
    "translate-selection": { "suggested_key": { "default": "Alt+Shift+Y" }, "description": "選択した文を翻訳" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "web_accessible_resources": [
    { "resources": ["viewer.html"], "matches": ["<all_urls>"] }
  ]
}
